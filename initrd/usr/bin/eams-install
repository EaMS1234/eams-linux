#!/bin/sh

TMP=/mnt/tmp/
TMP_BOOT=/mnt/boot/
TMP_LIVE=/mnt/live/

echo "EaMS Linux simplified installation script"

DEV_ISO=$(findfs LABEL="eams-linux-live")

if [[ -z "$DEV_ISO" ]]; then
  echo "Error: could not find EaMS Linux installation medium."
  exit 1
fi

read -p "/boot partition (default is /dev/sda1): " BOOT
read -p "/ partition (default is /dev/sda2): " ROOT

if [[ -z "$BOOT" ]]; then
  BOOT="/dev/sda1"
fi

if [[ -z "$ROOT" ]]; then
  ROOT="/dev/sda2"
fi


echo " [1/6] Making filesystems..."

mkfs.vfat $BOOT
mkfs.ext2 $ROOT

mkdir -p $TMP
mount $ROOT $TMP

mkdir -p $TMP_BOOT
mount $BOOT $TMP_BOOT

mkdir -p $TMP_LIVE
mount $DEV_ISO $TMP_LIVE

mkdir $TMP/root/
mkdir $TMP/home/
mkdir $TMP/boot/
mkdir $TMP/mnt/


echo " [2/6] Copying files..."

mkdir -p $TMP_BOOT/boot
cp $TMP_LIVE/bzImage $TMP_BOOT
cp $TMP_LIVE/boot/limine.conf $TMP_BOOT/boot

cp -r /usr $TMP
cp -r /etc $TMP

ln -s usr/bin $TMP/bin
ln -s usr/lib $TMP/lib
ln -s usr/lib64 $TMP/lib64

rm $TMP/bin/eams-install
rm -r $TMP/usr/share/eams-install
if [ -e $TMP/lost+found ]; then rm -r $TMP/lost+found; fi


echo " [3/6] Making initrd.img..."

mkdir -p $TMP/initrd/usr/bin $TMP/initrd/usr/lib

cp /usr/lib/libc.so $TMP/initrd/usr/lib
cp /usr/lib/ld-musl-x86_64.so.1 $TMP/initrd/usr/lib
cp /usr/bin/busybox $TMP/initrd/usr/bin
busybox --install -s $TMP/initrd/usr/bin
cp /usr/bin/fsck.ext2 $TMP/initrd/usr/bin
cp /usr/share/eams-install/init $TMP/initrd
ln -s usr/bin $TMP/initrd/bin
ln -s usr/lib $TMP/initrd/lib

cd $TMP/initrd

find . -print0 | cpio --null -ov --format=newc | gzip -9 > $TMP_BOOT/initrd.img

cd /
rm -r $TMP/initrd


echo " [4/6] Configuring inittab and fstab"

rm $TMP/etc/inittab
cp /usr/share/eams-install/inittab $TMP/etc

touch $TMP/etc/fstab

ROOT_UUID=$(echo $(blkid $ROOT) | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')
BOOT_UUID=$(echo $(blkid $BOOT) | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')

echo "UUID=$ROOT_UUID / ext2 defaults" >> $TMP/etc/fstab
echo "UUID=$BOOT_UUID /boot vfat defaults" >> $TMP/etc/fstab


echo " [5/6] Installing limine on ${BOOT%?} partition ${BOOT: -1}"

sed -i '/^[[:space:]]*cmdline: console=tty1$/ s/$/ root=UUID='"$ROOT_UUID"'/' $TMP_BOOT/boot/limine.conf
mkdir -p $TMP_BOOT/EFI/BOOT
cp /usr/share/limine/limine-bios.sys $TMP_BOOT/boot/
cp /usr/share/limine/BOOTX64.EFI $TMP_BOOT/EFI/BOOT
limine bios-install ${BOOT%?} ${BOOT: -1}


echo " [6/6] Unmounting filesystems..."

umount $BOOT
umount $ROOT
umount $DEV_ISO


echo "EaMS Linux installation complete!"

