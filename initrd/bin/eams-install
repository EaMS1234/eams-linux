#!/bin/sh

ISO=/mnt/iso/
TMP=/mnt/tmp/

clear

echo "EaMS Linux Installation Script\n"

read -p "/ partition: " ROOT
read -p "/boot partition: " BOOT

echo "Making filesystems..."

mkfs.vfat $BOOT
mkfs.ext2 $ROOT

if [ ! -e /mnt ]; then
  mkdir /mnt
fi

mkdir $ISO
mount /dev/sr0 $ISO

mkdir $TMP
mount $ROOT $TMP

mkdir $TMP/boot/
mount $BOOT $TMP/boot/

echo "Copying files..."

cp $ISO/boot/bzImage $TMP/boot/
cp $ISO/boot/limine-bios.sys $TMP/boot/

cp -r /bin $TMP
cp -r /lib $TMP
cp -r /include $TMP
cp -r /share $TMP
cp -r /etc $TMP

echo "Making initrd.img... (Not yet implemented)"

cp $ISO/boot/initrd.img $TMP/boot/

echo "Installing limine..."

touch $TMP/boot/limine.conf
echo "timeout: 5" >> $TMP/boot/limine.conf
echo "/EaMS $(uname -srv)" >> $TMP/boot/limine.conf
echo "  protocol: linux" >> $TMP/boot/limine.conf
echo "  path: boot():/bzImage" >> $TMP/boot/limine.conf
echo "  module_path: boot():/initrd.img" >> $TMP/boot/limine.conf
echo "  cmdline: ip=dhcp" >> $TMP/boot/limine.conf

limine bios-install ${BOOT%?} 1

echo "EaMS Linux installation complete!"

