#!/bin/sh

ISO=/mnt/iso/
TMP=/mnt/tmp/
TMP_BOOT=/mnt/boot/

echo "EaMS Linux simplified installation script"

read -p "/ partition (/dev/sdX): " ROOT
read -p "/boot partition (/dev/sdX): " BOOT

echo " [1/6] Making filesystems..."

mkfs.vfat $BOOT
mkfs.ext2 $ROOT

if [ ! -e /mnt ]; then
  mkdir /mnt
fi

mkdir $ISO
mount /dev/sr0 $ISO

mkdir $TMP
mount $ROOT $TMP

mkdir $TMP_BOOT
mount $BOOT $TMP_BOOT

mkdir $TMP/root/
mkdir $TMP/home/
mkdir $TMP/boot/
mkdir $TMP/mnt/

echo " [2/6] Copying files..."

cp $ISO/boot/bzImage $TMP_BOOT
cp $ISO/boot/limine-bios.sys $TMP_BOOT

cp -r /bin $TMP
cp -r /lib $TMP
cp -r /include $TMP
cp -r /share $TMP
cp -r /etc $TMP

rm $TMP/bin/eams-install
if [ -e $TMP/lost+found ]; then rm -r $TMP/lost+found; fi

echo " [3/6] Making initrd.img..."

touch $TMP/init
chmod +x $TMP/init
echo "#!/bin/sh" >> $TMP/init
echo "mkdir -p /proc /sys /dev" >> $TMP/init
echo "mount -t proc proc /proc" >> $TMP/init
echo "mount -t sysfs sysfs /sys" >> $TMP/init
echo "mount -t devtmpfs devtmpfs /dev" >> $TMP/init
echo "mount $ROOT /root" >> $TMP/init
echo "exec run-init /root /bin/init" >> $TMP/init

cd $TMP
find . -path './etc' -prune -o -print0 | cpio --null -ov --format=newc | gzip -9 > $TMP_BOOT/initrd.img
cd /

rm $TMP/init

echo " [4/6] Configuring inittab and fstab"

sed -i '/::askfirst:-\/bin\/sh/d' $TMP/etc/inittab
echo "::respawn:-/bin/login" >> $TMP/etc/inittab

touch $TMP/etc/fstab

BOOT_UUID=$(echo $(blkid $BOOT) | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')

echo "UUID=$BOOT_UUID /boot vfat defaults" >> $TMP/etc/fstab

echo " [5/6] Installing limine on ${BOOT%?} partition ${BOOT: -1}"

touch $TMP_BOOT/limine.conf
echo "timeout: 5" >> $TMP_BOOT/limine.conf
echo "/EaMS $(uname -srv)" >> $TMP_BOOT/limine.conf
echo "  protocol: linux" >> $TMP_BOOT/limine.conf
echo "  path: boot():/bzImage" >> $TMP_BOOT/limine.conf
echo "  module_path: boot():/initrd.img" >> $TMP_BOOT/limine.conf
echo "  cmdline: ip=dhcp" >> $TMP_BOOT/limine.conf

limine bios-install ${BOOT%?} ${BOOT: -1}

echo " [6/6] Unmounting filesystems..."

umount $BOOT
umount $ROOT
umount $ISO
eject /dev/sr0

echo "EaMS Linux installation complete!"

